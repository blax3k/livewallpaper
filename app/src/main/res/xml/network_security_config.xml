<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext HTTP to local development addresses only.
        All other traffic still requires HTTPS.

        If connecting from a physical device, add your machine's LAN IP:
            <domain includeSubdomains="false">192.168.x.x</domain>
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.12</domain>
    </domain-config>
</network-security-config>
